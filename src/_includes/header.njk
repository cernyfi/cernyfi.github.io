{% set pageName = title %}
{% if page.url == "/" %}{% set pageName = "Home" %}{% endif %}
<header>
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Home">
      <i class="fas fa-house"></i>
      <span>Filip Černý</span>
    </a>

    <nav>
      <ul id="nav-menu">
        <li><a href="/" {% if page.url == "/" %}class="active"{% endif %}><i class="fas fa-home"></i>Home</a></li>
        <li><a href="/gallery/" {% if page.url == "/gallery/" %}class="active"{% endif %}><i class="fa-solid fa-images"></i>Gallery</a></li>
        <li><a href="/map/" {% if page.url == "/map/" %}class="active"{% endif %}><i class="fa-solid fa-map-location-dot"></i>Map</a></li>
        <li><a href="/docs/cernyfilip.pdf" target="_blank"><i class="fa-solid fa-file"></i>CV</a></li>
        <li><a href="/contact/" {% if page.url == "/contact/" %}class="active"{% endif %}><i class="fas fa-phone"></i>Contact</a></li>
        <li>
          <button id="theme-toggle">
            <i id="theme-icon" class="fa fa-moon"></i>
            <span id="theme-text">Dark Mode</span>
          </button>
        </li>
      </ul>
    </nav>

    <button id="hamburger-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span id="current-page-name">{{ pageName }}</span>
      <span class="hamburger-icon-wrap">
        <i id="hamburger-icon" class="fas fa-bars"></i>
        <i id="close-icon" class="fas fa-times" style="display:none;"></i>
      </span>
    </button>
  </div>
</header>
